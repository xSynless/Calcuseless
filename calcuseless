MIN_NUM = 0
MAX_NUM = 1000  # change anything

filename = "calcuseless.py"

print(f"generating {filename}...")

with open(filename, "w", encoding="utf-8") as f:
    
    f.write('# Calcuseless — The most deterministic zero-math calculator\n')
    f.write('user_input = input("enter (for example: 5 + 3): ").strip()\n\n')
    f.write('match user_input:\n')

    count = 0

    # 1.  (+)
    for a in range(MIN_NUM, MAX_NUM + 1):
        for b in range(MIN_NUM, MAX_NUM + 1):
            f.write(f'    case "{a} + {b}": print("result: {a + b}")\n')
            count += 1

    # 2. (-)
    for a in range(MIN_NUM, MAX_NUM + 1):
        for b in range(MIN_NUM, MAX_NUM + 1):
            f.write(f'    case "{a} - {b}": print("result: {a - b}")\n')
            count += 1

    # 3. (*)
    for a in range(MIN_NUM, MAX_NUM + 1):
        for b in range(MIN_NUM, MAX_NUM + 1):
            f.write(f'    case "{a} * {b}": print("result: {a * b}")\n')
            count += 1

    # 4. (/)
    for a in range(MIN_NUM, MAX_NUM + 1):
        for b in range(MIN_NUM, MAX_NUM + 1):
            if b == 0:
                f.write(f'    case "{a} / 0": print("u stupid af")\n')
            else:
                
                res = a // b if a % b == 0 else round(a / b, 4)
                f.write(f'    case "{a} / {b}": print("result: {res}")\n')
            count += 1

    
    f.write('    case _:\n')
    f.write('        print("nah Calcuseless!")\n')

print(f"maded {count} lines.")